generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model NotificationLog {
  id                      Int       @id @default(autoincrement()) @db.UnsignedInt
  merchant_id             Int?      @db.UnsignedInt
  notification_setting_id Int?      @db.UnsignedInt
  notification_type       String?   @db.VarChar(255)
  channel                 String?   @db.VarChar(255)
  recipient               String?   @db.VarChar(255)
  status                  String?   @db.VarChar(255)
  message                 String?   @db.Text
  error_message           String?   @db.Text
  sent_at                 DateTime? @db.DateTime
  data                    String?   @db.Text
  created_at              DateTime  @default(now()) @db.DateTime
  updated_at              DateTime  @updatedAt @db.DateTime

  @@map("notification_logs")
}

model NotificationSetting {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  merchant_id       Int?      @db.UnsignedInt
  notification_type String?   @db.VarChar(255)
  is_active         Boolean?  @default(true)
  email_enabled     Boolean?  @default(false)
  whatsapp_enabled  Boolean?  @default(false)
  last_sent_at      DateTime? @db.DateTime
  frequencies       String?   @db.Text
  created_at        DateTime  @default(now()) @db.DateTime
  updated_at        DateTime  @updatedAt @db.DateTime

  @@map("notification_settings")
}

model Widget {
  id                   Int      @id @default(autoincrement()) @db.UnsignedInt
  type                 String   @db.VarChar(255)
  category             String   @db.VarChar(255)
  key                  String   @unique @db.VarChar(255)
  title                String   @db.VarChar(255)
  description          String?  @db.Text
  icon                 String?  @db.VarChar(255)
  config               String?  @db.Text
  is_active            Boolean  @default(true)
  free_plan_allowed    Boolean  @default(false)
  notification_enabled Boolean  @default(false)
  sort_order           Int      @default(0)
  created_at           DateTime @default(now()) @db.DateTime
  updated_at           DateTime @updatedAt @db.DateTime

  @@map("widgets")
}
