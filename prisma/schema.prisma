generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model NotificationLog {
  id                      Int       @id @default(autoincrement()) @db.UnsignedInt
  merchant_id             Int?      @db.UnsignedInt
  notification_setting_id Int?      @db.UnsignedInt
  notification_type       String?   @db.VarChar(255)
  channel                 String?   @db.VarChar(255)
  recipient               String?   @db.VarChar(255)
  status                  String?   @db.VarChar(255)
  message                 String?   @db.Text
  error_message           String?   @db.Text
  sent_at                 DateTime? @db.DateTime
  data                    String?   @db.Text
  created_at              DateTime  @default(now()) @db.DateTime
  updated_at              DateTime  @updatedAt @db.DateTime

  @@map("notification_logs")
}

model NotificationSetting {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  merchant_id       Int?      @db.UnsignedInt
  notification_type String?   @db.VarChar(255)
  is_active         Boolean?  @default(true)
  email_enabled     Boolean?  @default(false)
  whatsapp_enabled  Boolean?  @default(false)
  last_sent_at      DateTime? @db.DateTime
  frequencies       String?   @db.Text
  created_at        DateTime  @default(now()) @db.DateTime
  updated_at        DateTime  @updatedAt @db.DateTime

  @@map("notification_settings")
}

model Widget {
  id                   Int      @id @default(autoincrement()) @db.UnsignedInt
  type                 String   @db.VarChar(255)
  category             String   @db.VarChar(255)
  key                  String   @unique @db.VarChar(255)
  title                String   @db.VarChar(255)
  description          String?  @db.Text
  icon                 String?  @db.VarChar(255)
  config               String?  @db.Text
  is_active            Boolean  @default(true)
  free_plan_allowed    Boolean  @default(false)
  notification_enabled Boolean  @default(false)
  sort_order           Int      @default(0)
  created_at           DateTime @default(now()) @db.DateTime
  updated_at           DateTime @updatedAt @db.DateTime

  @@map("widgets")
}

model Merchant {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  shop              String   @unique @db.VarChar(255)
  email             String?  @db.VarChar(255)
  access_token      String?  @db.Text
  theme_preference  String?  @db.VarChar(255)
  user_id           Int?     @db.UnsignedInt
  vector_store_id   String?  @db.VarChar(255)
  assistant_id      String?  @db.VarChar(255)
  created_at        DateTime @default(now()) @db.DateTime
  updated_at        DateTime @updatedAt @db.DateTime

  orders            Order[]

  @@map("merchants")
}

model Order {
  id                        Int       @id @default(autoincrement()) @db.UnsignedInt
  merchant_id              Int       @db.UnsignedInt
  shopify_order_id         String    @unique @db.VarChar(100)
  name                     String    @db.VarChar(50)
  email                    String?   @db.VarChar(100)
  phone                    String?   @db.VarChar(30)
  financial_status         String?   @db.VarChar(30)
  fulfillment_status       String?   @db.VarChar(30)
  order_status_url         String?   @db.Text
  note                     String?   @db.Text
  tags                     String?   @db.Text
  currency                 String    @db.VarChar(10)
  total_price              Decimal   @db.Decimal(15, 4)
  subtotal_price           Decimal   @db.Decimal(15, 4)
  total_tax                Decimal?   @db.Decimal(15, 4)
  total_discounts           Decimal?   @db.Decimal(15, 4)
  total_weight             Decimal?   @db.Decimal(10, 3)
  total_tax_set_amount     Decimal?   @db.Decimal(15, 4)
  total_tax_set_currency   String?   @db.VarChar(10)
  customer_id              String?   @db.VarChar(100)
  customer_email           String?   @db.VarChar(100)
  customer_phone           String?   @db.VarChar(30)
  customer_first_name      String?   @db.VarChar(100)
  customer_last_name       String?   @db.VarChar(100)
  customer_accepts_marketing Boolean? @default(false)
  customer_total_spent     Int?      @default(0)
  customer_total_orders    Int?      @default(0)
  created_at_shopify       DateTime? @db.DateTime
  updated_at_shopify       DateTime? @db.DateTime
  created_at               DateTime  @default(now()) @db.DateTime
  updated_at               DateTime  @updatedAt @db.DateTime

  merchant                 Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id, created_at_shopify])
  @@index([financial_status, fulfillment_status])
  @@map("orders")
}
